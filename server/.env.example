# 複製成 .env 後填入；.env 不會進 repo。說明見 server/README.md
# 資料庫密碼（docker compose 會用它建資料庫，並自動組出容器內的 DATABASE_URL）
POSTGRES_PASSWORD=change-me
# 只有在本機直接跑 uvicorn／alembic／pytest 時才用到；docker compose 裡的 app 會被覆蓋
DATABASE_URL=postgresql+psycopg://rag:change-me@localhost:5432/rag

GEMINI_API_KEY=
OPENAI_API_KEY=

# openssl rand -hex 32
JWT_SECRET=

# 允許呼叫 API 的前端網址，逗號分隔
CORS_ORIGINS=http://localhost:5500
PUBLIC_BASE_URL=http://localhost:8000

# 一個回合（從收到問題到回答）最多幾秒；超過就改給保守回答。要比反向代理的逾時短
CHAT_TIMEOUT_SECONDS=50
# start.sh／start.bat 監聽的位址與埠（Docker 不看）
HOST=127.0.0.1
PORT=8000
# 同時開幾個程式（uvicorn 會讀這個變數）。建議 = CPU 核心數，2～4
WEB_CONCURRENCY=2
# 資料庫連線池（每個程式各自一份）。程式數 ×（POOL_SIZE＋MAX_OVERFLOW）要小於 PostgreSQL 的 max_connections（預設 100）
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10

# 流程紀錄保留天數：超過的對話只清掉流程紀錄，對話內容與統計保留。0＝不清
TRACE_RETENTION_DAYS=90
# 伺服器 log 詳細程度：debug／info／warning／error
LOG_LEVEL=info
