# 複製成 .env 後填入；.env 不會進 repo。說明見 server/README.md
# 資料庫密碼（docker compose 會用它建資料庫，並自動組出容器內的 DATABASE_URL）
POSTGRES_PASSWORD=change-me
# 只有在本機直接跑 uvicorn／alembic／pytest 時才用到；docker compose 裡的 app 會被覆蓋
DATABASE_URL=postgresql+psycopg://rag:change-me@localhost:5432/rag

GEMINI_API_KEY=
OPENAI_API_KEY=

# openssl rand -hex 32
JWT_SECRET=

# 允許呼叫 API 的前端網址，逗號分隔
CORS_ORIGINS=http://localhost:5500
PUBLIC_BASE_URL=http://localhost:8000

# 一個回合（從收到問題到回答）最多幾秒；超過就改給保守回答。要比反向代理的逾時短
CHAT_TIMEOUT_SECONDS=50
# 資料庫連線池。連線只在讀寫時短暫持有，等模型時不佔，一般不用調
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=10

TRACE_RETENTION_DAYS=90
LOG_LEVEL=info

# 三個都填才會送 trace 到 Langfuse
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
