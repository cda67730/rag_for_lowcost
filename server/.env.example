# 複製成 .env 後填入；.env 不會進 repo。說明見 server/README.md
DATABASE_URL=postgresql+psycopg://rag:change-me@db:5432/rag
POSTGRES_PASSWORD=change-me

GEMINI_API_KEY=
OPENAI_API_KEY=

# openssl rand -hex 32
JWT_SECRET=

# 允許呼叫 API 的前端網址，逗號分隔
CORS_ORIGINS=http://localhost:5500
PUBLIC_BASE_URL=http://localhost:8000

TRACE_RETENTION_DAYS=90
LOG_LEVEL=info

# 三個都填才會送 trace 到 Langfuse
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
